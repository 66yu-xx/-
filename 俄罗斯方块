<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
<title>手机俄罗斯方块</title>
<style>
  :root{--bg:#101218;--panel:#181b24;--line:#2b3040;--text:#f4f7ff;--muted:#aab2c8}
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent;touch-action:manipulation}
  html,body{margin:0;height:100%;background:radial-gradient(circle at top,#22283a,#0c0e13 62%);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;overflow:hidden}
  body{display:flex;justify-content:center;align-items:center;padding:env(safe-area-inset-top) 10px env(safe-area-inset-bottom)}
  .game{width:min(100%,460px);height:100%;display:flex;flex-direction:column;gap:10px;justify-content:center}
  .top{display:flex;justify-content:space-between;align-items:center;background:rgba(24,27,36,.92);border:1px solid var(--line);border-radius:18px;padding:10px 12px}
  h1{font-size:18px;margin:0}.stats{font-size:13px;color:var(--muted);text-align:right}.stats b{color:#fff;font-size:16px}
  .middle{display:grid;grid-template-columns:1fr 96px;gap:10px}
  canvas#board{width:100%;aspect-ratio:10/20;background:#080a0f;border:2px solid var(--line);border-radius:18px}
  .side{display:flex;flex-direction:column;gap:10px}.card{background:rgba(24,27,36,.92);border:1px solid var(--line);border-radius:16px;padding:10px;text-align:center}.label{font-size:12px;color:var(--muted);margin-bottom:6px}#next{width:72px;height:72px;background:#080a0f;border-radius:12px;border:1px solid var(--line)}
  button{border:1px solid rgba(255,255,255,.08);border-radius:16px;background:linear-gradient(#30384b,#222838);color:#fff;font-weight:800;font-size:18px;box-shadow:0 6px 0 rgba(0,0,0,.28);padding:0}
  button:active{transform:translateY(3px);box-shadow:0 3px 0 rgba(0,0,0,.28)}
  .small{height:48px;font-size:14px}.controls{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px}.controls button{height:64px}.wide{grid-column:span 3;height:56px}.ghost{font-size:13px;color:var(--muted);text-align:center}
  .overlay{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.55);backdrop-filter:blur(4px);padding:20px}.modal{width:min(92vw,390px);background:#181b24;border:1px solid var(--line);border-radius:24px;text-align:center;padding:22px}.modal h2{margin:0 0 8px;font-size:26px}.modal p{color:var(--muted);line-height:1.55}.modal button{width:100%;height:56px;margin-top:8px}.hide{display:none}
</style>
</head>
<body>
<div class="game">
  <div class="top">
    <h1>俄罗斯方块</h1>
    <div class="stats">分数 <b id="score">0</b><br>最高分 <b id="best">0</b></div>
  </div>
  <div class="middle">
    <canvas id="board" width="300" height="600"></canvas>
    <div class="side">
      <div class="card"><div class="label">下一个</div><canvas id="next" width="96" height="96"></canvas></div>
      <button id="pause" class="small">暂停</button>
      <button id="restart" class="small">重开</button>
    </div>
  </div>
  <div class="controls">
    <button id="left">⬅️</button><button id="rotate">🔄</button><button id="right">➡️</button>
    <button id="down">⬇️</button><button id="drop" class="wide">快速下落</button>
  </div>
  <div class="ghost">也可滑动：左右移动，上滑旋转，下滑快速下落</div>
</div>
<div id="overlay" class="overlay"><div class="modal"><h2 id="title">开始游戏</h2><p>触摸按钮控制方块。最高分会自动保存在手机浏览器里。</p><button id="start">开始</button></div></div>
<script>
const W=10,H=20,S=30,canvas=document.getElementById('board'),ctx=canvas.getContext('2d'),ncv=document.getElementById('next'),nctx=ncv.getContext('2d'),scoreEl=document.getElementById('score'),bestEl=document.getElementById('best'),overlay=document.getElementById('overlay'),titleEl=document.getElementById('title');
const COLORS={I:'#3bd5ff',J:'#4c7dff',L:'#ff9d2e',O:'#ffd93b',S:'#50e37b',T:'#b46cff',Z:'#ff5470'};
const SHAPES={I:[[1,1,1,1]],J:[[1,0,0],[1,1,1]],L:[[0,0,1],[1,1,1]],O:[[1,1],[1,1]],S:[[0,1,1],[1,1,0]],T:[[0,1,0],[1,1,1]],Z:[[1,1,0],[0,1,1]]};
let board,piece,nextPiece,score,best=+localStorage.getItem('tetris-best-cn')||0,dropCounter=0,last=0,over=true,paused=false;bestEl.textContent=best;
function clone(m){return m.map(r=>r.slice())}
function rand(){const k=Object.keys(SHAPES)[Math.floor(Math.random()*7)];return {k,m:clone(SHAPES[k]),x:3,y:0}}
function reset(){board=Array.from({length:H},()=>Array(W).fill(0));score=0;scoreEl.textContent=0;piece=rand();nextPiece=rand();dropCounter=0;last=0;over=false;paused=false;overlay.classList.add('hide');draw();requestAnimationFrame(loop)}
function collide(p){for(let y=0;y<p.m.length;y++)for(let x=0;x<p.m[y].length;x++)if(p.m[y][x]){let nx=p.x+x,ny=p.y+y;if(nx<0||nx>=W||ny>=H||(ny>=0&&board[ny][nx]))return true}return false}
function merge(){piece.m.forEach((r,y)=>r.forEach((v,x)=>{if(v&&piece.y+y>=0)board[piece.y+y][piece.x+x]=piece.k}))}
function rotate(){const m=piece.m,r=m[0].map((_,i)=>m.map(row=>row[i]).reverse()),old=piece.m,oldx=piece.x;piece.m=r;for(const dx of [0,-1,1,-2,2]){piece.x=oldx+dx;if(!collide(piece))return}piece.m=old;piece.x=oldx}
function clearLines(){let lines=0;outer:for(let y=H-1;y>=0;y--){for(let x=0;x<W;x++)if(!board[y][x])continue outer;board.splice(y,1);board.unshift(Array(W).fill(0));lines++;y++}if(lines){score += [0,100,300,500,800][lines]||1000;scoreEl.textContent=score;if(score>best){best=score;bestEl.textContent=best;localStorage.setItem('tetris-best-cn',best)}}}
function spawn(){piece=nextPiece;piece.x=3;piece.y=0;nextPiece=rand();if(collide(piece)){over=true;titleEl.textContent='游戏结束';overlay.classList.remove('hide')}}
function move(dx){piece.x+=dx;if(collide(piece))piece.x-=dx;draw()}
function soft(){piece.y++;if(collide(piece)){piece.y--;merge();clearLines();spawn()}draw()}
function hard(){while(!collide(piece))piece.y++;piece.y--;merge();clearLines();spawn();draw()}
function cell(c,x,y,s,context){context.fillStyle=c;context.fillRect(x*s+1,y*s+1,s-2,s-2);context.fillStyle='rgba(255,255,255,.16)';context.fillRect(x*s+3,y*s+3,s-6,4)}
function draw(){ctx.clearRect(0,0,300,600);ctx.fillStyle='#080a0f';ctx.fillRect(0,0,300,600);ctx.strokeStyle='rgba(255,255,255,.045)';for(let x=0;x<=W;x++){ctx.beginPath();ctx.moveTo(x*S,0);ctx.lineTo(x*S,600);ctx.stroke()}for(let y=0;y<=H;y++){ctx.beginPath();ctx.moveTo(0,y*S);ctx.lineTo(300,y*S);ctx.stroke()}board.forEach((r,y)=>r.forEach((v,x)=>{if(v)cell(COLORS[v],x,y,S,ctx)}));if(piece)piece.m.forEach((r,y)=>r.forEach((v,x)=>{if(v)cell(COLORS[piece.k],piece.x+x,piece.y+y,S,ctx)}));drawNext()}
function drawNext(){nctx.clearRect(0,0,96,96);nctx.fillStyle='#080a0f';nctx.fillRect(0,0,96,96);if(!nextPiece)return;const m=nextPiece.m,s=20,ox=(96-m[0].length*s)/2,oy=(96-m.length*s)/2;nctx.save();nctx.translate(ox,oy);m.forEach((r,y)=>r.forEach((v,x)=>{if(v)cell(COLORS[nextPiece.k],x,y,s,nctx)}));nctx.restore()}
function loop(t=0){if(over)return;const delta=t-last;last=t;if(!paused){dropCounter+=delta;if(dropCounter>650){soft();dropCounter=0}draw()}requestAnimationFrame(loop)}
function btn(id,fn){document.getElementById(id).addEventListener('click',e=>{e.preventDefault();fn()})}
btn('left',()=>{if(!over&&!paused)move(-1)});btn('right',()=>{if(!over&&!paused)move(1)});btn('rotate',()=>{if(!over&&!paused){rotate();draw()}});btn('down',()=>{if(!over&&!paused)soft()});btn('drop',()=>{if(!over&&!paused)hard()});btn('restart',reset);btn('start',reset);btn('pause',()=>{if(over)return;paused=!paused;document.getElementById('pause').textContent=paused?'继续':'暂停'});
let sx=0,sy=0;canvas.addEventListener('touchstart',e=>{sx=e.touches[0].clientX;sy=e.touches[0].clientY},{passive:true});canvas.addEventListener('touchend',e=>{if(over||paused)return;let dx=e.changedTouches[0].clientX-sx,dy=e.changedTouches[0].clientY-sy;if(Math.abs(dx)>Math.abs(dy)&&Math.abs(dx)>24)move(dx>0?1:-1);else if(dy<-24){rotate();draw()}else if(dy>24)hard()},{passive:true});
</script>
</body>
</html>
